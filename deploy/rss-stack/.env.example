# Copy to .env, chmod 600 .env, then replace all CHANGE_ME values.
COMPOSE_PROJECT_NAME=rss
COMPOSE_FILE=docker-compose.yml:docker-compose.runtime.yml:docker-compose.anthropic.yml:docker-compose.thediff.yml
BASE_URL=http://localhost:8000
RSSBOX_SITE_URL=http://localhost:8000
RSSBOX_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET
RSSHUB_ACCESS_KEY=CHANGE_ME_GENERATE_ANOTHER_RANDOM_SECRET
# Set cookies only for sources you subscribe to. Empty values disable authenticated access.
CAIXIN_COOKIE=""
NYT_S_COOKIE=
TWITTER_AUTH_TOKEN=
INITIUM_MEMBER_COOKIE=
SINOCISM_COOKIE=
THEDIFF_COOKIE=
THEDIFF_COOKIE_SIG=
# Optional Cloudflare Tunnel: enable the tunnel profile after configuring your hostname.
TUNNEL_TOKEN=
# Optional explicit fallback; empty disables provider fallback.
TRANSLATION_FALLBACK_OPENAI_AGENT_ID=
# Optional private plan adapter; not enabled by the default COMPOSE_FILE.
RSS_PLAN_BRIDGE_KEY=
